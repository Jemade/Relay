# Database Configuration (Defaults to local SQLite async)
# For Supabase or PostgreSQL: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./relay.db

# LLM Providers (Supply when ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model Configuration
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=auto

# Server Configuration
PORT=8000
DEBUG=true
